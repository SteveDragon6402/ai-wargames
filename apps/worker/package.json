{
  "name": "@wargame/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "predev": "pnpm --filter @wargame/server build",
    "dev": "tsc && (tsc -w --preserveWatchOutput &) && node --watch dist/index.js",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@wargame/db": "workspace:*",
    "@wargame/engine": "workspace:*",
    "@wargame/server": "workspace:*",
    "@wargame/shared": "workspace:*",
    "bullmq": "^5.34.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
