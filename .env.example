# =============================================================================
# AI WARGAMES — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://wargame:wargame@localhost:5432/wargame

# ---------------------------------------------------------------------------
# Cache (Redis) — BullMQ turn timers + optional Socket.IO scaling
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Turn Timer
# ---------------------------------------------------------------------------
DEFAULT_TURN_DURATION_SECONDS=90

# ---------------------------------------------------------------------------
# Scenarios (path to repo scenarios/ folder)
# ---------------------------------------------------------------------------
SCENARIOS_DIR=

# ---------------------------------------------------------------------------
# Web + Worker (local dev)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
PORT=3001

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Site gate
# ---------------------------------------------------------------------------
# Every page and API route stays locked until this passphrase is entered.
# Leave unset to use the built-in passphrase. ANTHROPIC_API_KEY must be set;
# it signs the session cookie.
# GATE_PASSWORD=

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# Password required to access the admin panel on the home page.
# Change this in production — defaults to "admin" if unset.
ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
# Your Anthropic API key — server-side only, never sent to browser
ANTHROPIC_API_KEY=xx

# Model overrides (optional — defaults shown below)
MODEL_GM=claude-sonnet-4-6
MODEL_ADJUDICATOR=claude-sonnet-4-6
MODEL_ADVISOR=claude-haiku-4-5-20251001
MODEL_AI_FACTION=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# One Life
# ---------------------------------------------------------------------------
# Story uses Anthropic (claude-sonnet-4-6). Pictures use Gemini.
# Without GEMINI_API_KEY the life is still written.
GEMINI_API_KEY=
# GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# Le Séjour — Authentication, Invite System & Admin
# ---------------------------------------------------------------------------
# Secret used to sign 90-day browser session cookies
AUTH_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of admin email addresses (automatically granted admin role)
ADMIN_EMAILS=you@example.com

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI (local): http://localhost:3000/api/auth/google/callback
# Authorized Redirect URI (Railway): https://<your-railway-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit redirect override (auto-detected from request origin if omitted)
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Le Séjour — French LLMs & Voice TTS (Primary + Open-Weight Fallbacks)
# ---------------------------------------------------------------------------
# Primary LLM: ANTHROPIC_API_KEY (above). Fallback LLM: Mistral (mistral-small-latest)
MISTRAL_API_KEY=

# Primary TTS: ElevenLabs. Fallback TTS: Orpheus 3B French (local or remote endpoint)
ELEVENLABS_API_KEY=
ORPHEUS_TTS_URL=http://127.0.0.1:5005/v1/audio/speech
